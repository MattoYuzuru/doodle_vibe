# Dedicated Telegram webhook site. The Mini App and Mnema sites remain direct.
doodle-hook.mnema.app {
	@telegramWebhook {
		method POST
		path /api/telegram/webhook
	}
	handle @telegramWebhook {
		header Cache-Control no-store
		reverse_proxy 127.0.0.1:18110 {
			transport http {
				dial_timeout 2s
				response_header_timeout 15s
			}
		}
	}
	handle {
		respond 404
	}
}
