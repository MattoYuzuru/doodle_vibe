# История изменений проекта Doodle (git). В неё идёт только код и документы; секреты, данные пользователей,
# работы студентов и установленные программы — нет. Правило: сначала всё исключено, затем разрешены нужные папки.
/*
!/.gitignore
!/HANDOFF.md
!/jarvis-app/
!/ops/
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/CONTRIBUTING.md
!/docs/
!/mascot/
!/.github/
!/scripts/
!/tests/
!/package.json
!/package-lock.json
!/requirements-test.txt
!/.nvmrc
!/.node-version
!/playwright.config.mjs
!/backend/

# Development tooling and synthetic test artifacts; never commit runtime secrets/state.
.venv/
artifacts/
playwright-report/
test-results/
.env
.env.*
*.sqlite
*.sqlite-*
*.db
*.db-*

# --- секреты (никогда не добавлять) ---
jarvis-app/bot-token.txt
jarvis-app/bot-token-new.txt
jarvis-app/bot-token-prev.txt
jarvis-app/cloud/
jarvis-app/users.key
jarvis-app/ngrok-token.txt
jarvis-app/ngrok.yml
jarvis-app/local-owner.flag
*.key
*.pem

# --- данные пользователей и состояние сервера ---
jarvis-app/users/
jarvis-app/labs.off
jarvis-app/jobs/
jarvis-app/notify/
jarvis-app/checks/
jarvis-app/usage/
jarvis-app/diag/
jarvis-app/ej-debug/
jarvis-app/lessons/
jarvis-app/course-styles/
jarvis-app/quality/
jarvis-app/welcome-media.json
jarvis-app/bot-updates.on
jarvis-app/cal-cache/
jarvis-app/deadlines-cache/
jarvis-app/**/*.bad-*
jarvis-app/schedule-cache/
jarvis-app/lab-allowlist.txt
jarvis-app/notify-state.old.json
jarvis-app/current-url.txt
jarvis-app/tunnel-nobind.flag
ops/job-backups/
ops/*.state.json
ops/*.backup.json
ops/*.lock
ops/*.bak-*

# --- журналы, сборки, зависимости, временное ---
*.log
*.log.*
*.tmp
node_modules/
__pycache__/
jarvis-app/web/dist/
jarvis-app/ops/stand/sim/
jarvis-app/ops/stand/sim-ui/
jarvis-app/ops/migrate/*.zip

# сторож агента: журнал отказов и отметка «вызывается»
jarvis-app/ops/agent-guard/guard.log
jarvis-app/ops/agent-guard/guard.seen
jarvis-app/ops/agent-guard/guard.alert

# ежедневные копии данных и их настройка
jarvis-app/backups/
jarvis-app/backup.json

# учётная запись агента лаб (ops/migrate/agent-account): настройка этого ПК и выгрузка для 2-агент.cmd
jarvis-app/agent-account.json
jarvis-app/ops/migrate/agent-account/export/

# состояние бесед и рассылок: Telegram-ID студентов и названия бесед
jarvis-app/chats.json
jarvis-app/announce-session-state.json
jarvis-app/bot-move-state.json
