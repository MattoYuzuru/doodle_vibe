' ER-диаграмма (модель данных).
' Правила:
'  1. До 8–10 сущностей. Главную сущность объявляй первой, зависимые — после неё.
'  2. Связь «один ко многим» рисуй сверху вниз («Родитель ||--o{ Потомок»), справочники — сбоку одной чертой («A }o-|| B»).
'  3. В сущности — ключ, внешние ключи и 3–5 главных полей с типами.
'  4. Подпись связи — глагол: «содержит», «принадлежит».
'  5. Связь «многие ко многим» раскрывай промежуточной сущностью.
@startuml
hide methods

entity "Пользователь" as user {
  * id : int <<PK>>
  --
  имя : varchar
  телефон : varchar
}

entity "Дом" as home {
  * id : int <<PK>>
  --
  владелец_id : int <<FK>>
  адрес : varchar
}

entity "Комната" as room {
  * id : int <<PK>>
  --
  дом_id : int <<FK>>
  название : varchar
}

entity "Устройство" as device {
  * id : int <<PK>>
  --
  комната_id : int <<FK>>
  тип_id : int <<FK>>
  состояние : varchar
}

entity "Тип устройства" as kind {
  * id : int <<PK>>
  --
  название : varchar
}

entity "Событие" as event {
  * id : int <<PK>>
  --
  устройство_id : int <<FK>>
  время : datetime
  значение : varchar
}

user ||--o{ home : владеет
home ||--o{ room : содержит
room ||--o{ device : содержит
device }o-|| kind : относится
device ||--o{ event : порождает
@enduml
