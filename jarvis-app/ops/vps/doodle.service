# Служба основного сервера Doodle на Linux VPS (бот, Mini App, Moodle, журнал, расписание).
# Установка (под root): cp doodle.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now doodle
# Журнал: journalctl -u doodle -f  (и jarvis-app/server.log).
# Лаб на этом сервере нет — их выполняет отдельный исполнитель, поэтому Windows-части выключены переменными ниже.
[Unit]
Description=Doodle server
After=network-online.target
Wants=network-online.target

[Service]
User=doodle
WorkingDirectory=/home/doodle/moodle-work/jarvis-app
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Только локально: снаружи сервер откроет обратный прокси с HTTPS (Caddy), когда дойдём до домена.
Environment=HOST=127.0.0.1
Environment=PORT=8787
# Постоянный адрес Mini App: по нему tunnel-url.mjs держит кнопку меню бота и current-url.txt. Пока НЕ задан: прямой
# адрес sslip.io не открывается у студентов с VPN, кнопка ведёт на туннель Cloudflare (doodle-tunnel.service, адрес из
# tunnel.log). Вернуть, когда будет свой домен за Cloudflare: Environment=APP_URL=https://<домен>
#Environment=APP_URL=https://72-56-249-191.sslip.io
# Туннель календаря ngrok — Windows-ПК; на VPS постоянный адрес даст домен.
Environment=CAL_TUNNEL=0
# Сторож агента лаб (настройки Claude Code агента) — его здесь нет.
Environment=GUARD_WATCH=0
# Обход VPN через route print — на VPS VPN нет, ходим обычным маршрутом.
Environment=MOODLE_DIRECT=0
Environment=PYTHON=/usr/bin/python3
# Адрес подписки на календарь: пусто — постоянного адреса нет, приложение даёт разовый файл (ngrok с российских IP не
# работает, calendar-base.txt ведёт на мёртвый домен). Появится домен — вписать: Environment=CAL_BASE=https://<домен>
Environment=CAL_BASE=
# Агента лаб здесь нет: действия, которые его зовут, отвечают «Лабы временно недоступны» (server.mjs labsOff).
# Убрать строку, когда сервер научится отдавать лабы исполнителю.
Environment=LABS_OFF=1
StandardOutput=append:/home/doodle/moodle-work/jarvis-app/server.log
StandardError=append:/home/doodle/moodle-work/jarvis-app/server.log

[Install]
WantedBy=multi-user.target
