# Doodle: Mini App и API по HTTPS. Временный адрес sslip.io (имя = IP сервера), сертификат Let's Encrypt выпускает Caddy сам.
# Кнопка меню бота сюда НЕ ведёт: у студентов с VPN прямой адрес российского сервера не открывается, Mini App идёт через
# туннель Cloudflare (doodle-tunnel.service). Этот адрес — запасной и для проверок.
# Установка (под root): cp Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy
# Тот же адрес — в jarvis-app/current-url.txt на сервере (по нему бот строит ссылки и кнопку меню).
# Свой домен: заменить имя ниже (A-запись домена → IP сервера), перезагрузить Caddy и поправить current-url.txt.
72-56-249-191.sslip.io {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787
	# Журнал запросов — в journalctl -u caddy (файл в /var/log/caddy Caddy открыть не смог).
	log {
		output stderr
	}
}
